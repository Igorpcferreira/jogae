// Jogaê — camada operacional do fut.
// Princípio: multi-grupo desde o modelo de dados. Nada de valor específico
// (quinta-feira, 4 times, 5 na linha) vive no schema — tudo é config do grupo.

generator client {
  provider = "prisma-client"
  output   = "../src/db/generated"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Identidade e acesso
// ─────────────────────────────────────────────────────────────

/// Quem entra no app. A identidade em si (senha, Google, OTP) vive no Supabase
/// Auth; aqui fica só o perfil e o que o domínio precisa.
model User {
  id        String   @id @default(cuid())
  /// `sub` do JWT do Supabase. Nulo enquanto o cadastro existir sem nunca ter
  /// logado — é o caso do elenco importado e do convidado que ainda não entrou.
  authId    String?  @unique
  name      String
  email     String   @unique
  avatarUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
}

/// Convite pra ajudar a tocar um grupo.
///
/// Não tem token: a capacidade é controlar o e-mail, e quem verifica isso é o
/// Supabase (Google ou código por e-mail). Quando alguém entra, todo convite
/// aberto pro e-mail dele vira vínculo. É mais simples e mais forte do que um
/// link secreto que pode ser encaminhado.
model Invite {
  id         String    @id @default(cuid())
  email      String
  groupId    String
  role       Role
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  group FootballGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([email, consumedAt])
  @@index([groupId])
  @@index([expiresAt])
}

enum Role {
  OWNER
  ADMIN
  ASSISTANT
}

model Membership {
  id      String @id @default(cuid())
  userId  String
  groupId String
  role    Role   @default(ADMIN)

  createdAt DateTime @default(now())

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  group FootballGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([userId, groupId])
  @@index([groupId])
}

// ─────────────────────────────────────────────────────────────
// Grupo de Fut — a entidade central
// ─────────────────────────────────────────────────────────────

enum SportType {
  SOCIETY
  FUTSAL
  CAMPO
  CUSTOM
}

/// Como o grupo trata goleiro. Configurável por grupo (plano §16).
enum GoalkeeperMode {
  /// Cada time recebe um goleiro fixo na rodada.
  FIXED_PER_TEAM
  /// Goleiros formam um pool próprio e são alocados por partida.
  POOL
  /// Não há goleiro dedicado — revezamento entre jogadores de linha.
  ROTATING
  /// O time que está de fora empresta o goleiro.
  BORROWED
}

model FootballGroup {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  logoUrl     String?
  sportType   SportType @default(SOCIETY)
  timezone    String    @default("America/Sao_Paulo")

  // Local padrão
  defaultVenue       String?
  defaultVenueUrl    String?

  // Recorrência padrão — 0=domingo … 6=sábado
  recurringWeekdays  Int[]   @default([])
  defaultStartTime   String? // "20:30"
  defaultDurationMin Int     @default(90)

  // Formato padrão do fut
  teamCount           Int            @default(4)
  fieldPlayersPerTeam Int            @default(5)
  goalkeepersPerTeam  Int            @default(1)
  goalkeeperMode      GoalkeeperMode @default(FIXED_PER_TEAM)
  waitlistLimit       Int            @default(10)

  /// Configurações avançadas e opcionais (regras de partida, ranking, cores).
  settings Json @default("{}")

  /// Link de convidado do grupo (`/e/<publicToken>`): o link único que o
  /// organizador cola na conversa do WhatsApp. Ele abre a lista de nomes do
  /// elenco e deixa cada um dizer quem é — a partir daí a pessoa cai no link
  /// pessoal dela (`Player.selfToken`) e responde presença sem conta nenhuma.
  ///
  /// É **credencial**, não identificador: quem tem o link vê os nomes do elenco
  /// e pode responder no lugar de qualquer um deles. Por isso UUID v4 gerado
  /// pelo banco, e não o `cuid()` que ele tinha — cuid carrega contador e
  /// fingerprint da máquina, então dois grupos criados em sequência têm tokens
  /// parentes. Mesmo raciocínio de `Player.selfToken`.
  ///
  /// Gravar um valor novo é o que revoga o link antigo (tela de configuração).
  publicToken String @unique @default(dbgenerated("gen_random_uuid()::text"))

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  invites     Invite[]
  players     Player[]
  rounds      Round[]
}

// ─────────────────────────────────────────────────────────────
// Jogadores
// ─────────────────────────────────────────────────────────────

enum PreferredRole {
  GOALKEEPER
  DEFENDER
  MIDFIELDER
  FORWARD
  VERSATILE
}

model Player {
  id      String @id @default(cuid())
  groupId String

  displayName String
  nickname    String?
  avatarUrl   String?

  /// Nível técnico 1–5. Privado: nunca exposto em rota pública (plano §13).
  skillLevel    Int           @default(3)
  preferredRole PreferredRole @default(VERSATILE)
  isGoalkeeper  Boolean       @default(false)
  active        Boolean       @default(true)
  notes         String?

  /// Link pessoal do jogador (`/p/<selfToken>`): a credencial que deixa ele
  /// confirmar presença sem ter conta (bloco I, opção B). Não expira — link por
  /// rodada obrigaria a redistribuir 22 links toda semana no WhatsApp, e esse
  /// atrito mata a adoção. Gravar um valor novo é o que revoga o link antigo.
  ///
  /// UUID v4 e não `cuid()` (que os outros tokens usam) porque este token
  /// *muda presença*: cuid carrega contador e fingerprint da máquina, então
  /// dois gerados em sequência são parentes. Aqui são 122 bits de aleatório.
  ///
  /// O default é do **banco**, não do client (`@default(uuid(4))` seria gerado
  /// no Prisma). Assim o código que já está no ar, que não conhece esta coluna,
  /// continua criando jogador entre a migration e o deploy — e importar lista
  /// cria jogador, então essa janela não é teórica.
  selfToken String @unique @default(dbgenerated("gen_random_uuid()::text"))

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group       FootballGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  aliases     PlayerAlias[]
  attendances Attendance[]
  teamPlayers TeamPlayer[]
  goals       MatchEvent[]  @relation("EventAuthor")
  assists     MatchEvent[]  @relation("EventAssist")
  votosDados  MvpVote[]     @relation("VotoDoJogador")
  votosRecebidos MvpVote[]  @relation("VotoNoJogador")

  @@index([groupId, active])
}

/// Apelidos que o organizador confirmou uma vez e o grupo "aprendeu" (plano §12).
model PlayerAlias {
  id       String @id @default(cuid())
  playerId String
  alias    String
  /// Forma normalizada (sem acento, minúscula, sem pontuação) usada no match.
  normalized String

  createdAt DateTime @default(now())

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([playerId, normalized])
  @@index([normalized])
}

// ─────────────────────────────────────────────────────────────
// Rodadas
// ─────────────────────────────────────────────────────────────

enum RoundStatus {
  OPEN
  CONFIRMED
  LIVE
  FINISHED
  CANCELLED
}

model Round {
  id      String @id @default(cuid())
  groupId String

  date     DateTime
  startsAt DateTime?
  endsAt   DateTime?
  venue    String?
  venueUrl String?
  notes    String?

  status RoundStatus @default(OPEN)

  // Snapshot do formato no momento da rodada — o grupo pode mudar depois.
  teamCount           Int
  fieldPlayersPerTeam Int
  goalkeeperMode      GoalkeeperMode

  // Rastro do sorteio (plano §35 — transparência)
  drawMode     DrawMode?
  drawSeed     String?
  drawnAt      DateTime?
  manualEdits  Int       @default(0)

  /// Token do link público da rodada.
  publicToken String @unique @default(cuid())

  /// Quando o apito final soou — é daqui que a janela de votação de craque
  /// conta as 48h (`domain/mvp/votacao.ts`).
  ///
  /// Separado de `endsAt` de propósito: aquele é o horário **previsto** do fim,
  /// que vem do formato do grupo e existe desde antes de a bola rolar. Este é o
  /// instante em que alguém encerrou a rodada de verdade. Nulo nas rodadas
  /// encerradas antes desta coluna existir — a consulta cai na data da rodada.
  finishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group       FootballGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  attendances Attendance[]
  teams       Team[]
  matches     Match[]
  votos       MvpVote[]

  @@index([groupId, date])
}

/// Voto pra "Escolha da galera" (plano §27, Fase 2).
///
/// O voto é **secreto**: o par votante→votado existe aqui porque é o que
/// garante um voto por pessoa, e não sai desta tabela. Nenhuma consulta do app
/// devolve "quem votou em quem" — `apurarVotacao` recebe os pares e entrega só
/// o vencedor. Mostrar o placar completo transformaria o prêmio numa discussão
/// de segunda-feira, que é exatamente o que o plano manda evitar.
///
/// Quem vota é um `Player`, não um `User`: no Jogaê o jogador não tem conta —
/// ele se identifica pelo link pessoal (`Player.selfToken`, bloco I). É essa
/// credencial que faz "um voto por pessoa" sair de graça.
model MvpVote {
  id      String @id @default(cuid())
  roundId String

  voterPlayerId String
  votedPlayerId String

  createdAt DateTime @default(now())

  round Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  voter Player @relation("VotoDoJogador", fields: [voterPlayerId], references: [id], onDelete: Cascade)
  voted Player @relation("VotoNoJogador", fields: [votedPlayerId], references: [id], onDelete: Cascade)

  /// Um voto por pessoa por rodada — a regra vive no banco, não só na action.
  @@unique([roundId, voterPlayerId])
  @@index([roundId, votedPlayerId])
}

enum DrawMode {
  RANDOM
  BALANCED
  MANUAL
}

enum AttendanceStatus {
  CONFIRMED
  WAITING
  ABSENT
}

/// Quem mexeu nesta presença por último.
enum AttendanceOrigin {
  /// Veio da lista colada ou do dedo do organizador.
  ORGANIZER
  /// O próprio jogador, pelo link pessoal dele.
  PLAYER
}

model Attendance {
  id       String @id @default(cuid())
  roundId  String
  playerId String

  status AttendanceStatus @default(CONFIRMED)
  /// Posição na lista (ordem de chegada / ordem na espera).
  order  Int
  /// Confirmado especificamente como goleiro nesta rodada.
  asGoalkeeper Boolean @default(false)
  /// De onde veio a última mudança. É o que separa "ele confirmou sozinho" de
  /// "o organizador colou a lista" — sem isso a sequência de presença da Fase 2
  /// seria mérito de quem organiza, não de quem joga.
  origin AttendanceOrigin @default(ORGANIZER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  round  Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([roundId, playerId])
  @@index([roundId, status, order])
}

// ─────────────────────────────────────────────────────────────
// Times
// ─────────────────────────────────────────────────────────────

model Team {
  id      String @id @default(cuid())
  roundId String

  name  String
  /// Slot de cor do design system: green | yellow | red | pink | …
  color String
  order Int

  createdAt DateTime @default(now())

  round   Round        @relation(fields: [roundId], references: [id], onDelete: Cascade)
  players TeamPlayer[]

  matchesAsA Match[]      @relation("TeamA")
  matchesAsB Match[]      @relation("TeamB")
  events     MatchEvent[]

  @@unique([roundId, order])
  @@index([roundId])
}

model TeamPlayer {
  id       String @id @default(cuid())
  teamId   String
  playerId String

  isGoalkeeper Boolean @default(false)
  /// Jogador travado pelo organizador — sorteios seguintes não o movem.
  locked       Boolean @default(false)

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([teamId, playerId])
  @@index([playerId])
}

// ─────────────────────────────────────────────────────────────
// Partidas e eventos
// ─────────────────────────────────────────────────────────────

enum MatchStatus {
  SCHEDULED
  LIVE
  FINISHED
}

model Match {
  id      String @id @default(cuid())
  roundId String

  teamAId String
  teamBId String

  scoreA Int         @default(0)
  scoreB Int         @default(0)
  status MatchStatus @default(SCHEDULED)
  order  Int

  startedAt DateTime?
  endedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  round  Round        @relation(fields: [roundId], references: [id], onDelete: Cascade)
  teamA  Team         @relation("TeamA", fields: [teamAId], references: [id], onDelete: Cascade)
  teamB  Team         @relation("TeamB", fields: [teamBId], references: [id], onDelete: Cascade)
  events MatchEvent[]

  @@index([roundId, order])
}

enum MatchEventType {
  GOAL
  OWN_GOAL
}

model MatchEvent {
  id      String @id @default(cuid())
  matchId String

  type   MatchEventType @default(GOAL)
  /// Time que marcou o ponto (para gol contra, é o time beneficiado).
  teamId String
  /// Autor. Pode ser nulo quando o organizador registra "gol sem autor".
  playerId       String?
  assistPlayerId String?

  /// Minuto do lance dentro da partida, quando houver cronômetro.
  minute Int?

  /// Id gerado no celular antes de o gol sair da fila offline (plano §40).
  /// É o que impede o mesmo gol entrar duas vezes quando a sincronização repete.
  clientEventId String? @unique

  /// Desfazer é soft-delete: mantém rastro e corrige estatística (plano §19).
  voidedAt DateTime?

  createdAt DateTime @default(now())

  match        Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team         Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player       Player? @relation("EventAuthor", fields: [playerId], references: [id], onDelete: SetNull)
  assistPlayer Player? @relation("EventAssist", fields: [assistPlayerId], references: [id], onDelete: SetNull)

  @@index([matchId, createdAt])
  @@index([playerId])
}
