# ── Banco ───────────────────────────────────────────────────────
# Local (npm run db:up) — atenção: a porta é 5433, não 5432.
DATABASE_URL="postgresql://jogae:jogae@localhost:5433/jogae?schema=public"

# Em produção com Supabase, use a URL do POOLER (porta 6543) aqui...
# DATABASE_URL="postgresql://postgres.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# ...e a DIRETA (porta 5432) para as migrations, senão `prisma migrate` trava.
# DIRECT_URL="postgresql://postgres.<ref>:<senha>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ── Autenticação (Supabase) ─────────────────────────────────────
# Project Settings → API. As duas primeiras são públicas por natureza:
# vão pro browser e é assim que tem que ser.
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# Chave secreta (service role). Só o servidor usa, e só pra disparar o e-mail
# de convite. Passa por cima de qualquer política do banco — nunca no client,
# nunca no git.
# SUPABASE_SECRET_KEY=""

# ── App ─────────────────────────────────────────────────────────
# URL pública usada em links compartilháveis, no login, no convite e na imagem
# de preview (og:image). EM PRODUÇÃO: o domínio real (https://...), porque é
# ela que monta o redirect de volta do Google.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Testes ──────────────────────────────────────────────────────
# Banco dos testes de integração. O schema PRECISA ser diferente de `public`:
# a suíte limpa as tabelas antes de cada teste.
# DATABASE_URL_TESTE="postgresql://jogae:jogae@localhost:5433/jogae?schema=teste"
